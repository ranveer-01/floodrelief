# FloodRelief Connect — environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows)

# Which settings module to load. dev = SQLite + DEBUG, production = PostgreSQL.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-insecure-key-replace-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Service-level target for time-to-acknowledgement, in hours (proposal metric).
ACKNOWLEDGEMENT_TARGET_HOURS=2

# --- PostgreSQL (config.settings.production only) ---------------------------
POSTGRES_DB=floodrelief
POSTGRES_USER=floodrelief
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- HTTPS hardening (production only) --------------------------------------
# Leave False until TLS actually terminates in front of the app.
SECURE_SSL_REDIRECT=False
